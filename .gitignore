# ==========================================
# Ambientes e Segredos (Raiz e Subpastas)
# ==========================================
.env
.env.backup
.env.production
.env.local
.env.*.local
*.key
*.pem

# ==========================================
# Backend (Laravel / PHP)
# ==========================================
backend/vendor/
backend/bootstrap/cache/*.php
backend/storage/*.key
backend/storage/app/public/
backend/storage/framework/cache/data/*
backend/storage/framework/sessions/*
backend/storage/framework/testing/*
backend/storage/framework/views/*
backend/storage/logs/*
!backend/storage/framework/cache/data/.gitignore
!backend/storage/framework/sessions/.gitignore
!backend/storage/framework/testing/.gitignore
!backend/storage/framework/views/.gitignore
!backend/storage/logs/.gitignore
backend/public/storage
backend/public/hot
backend/public/build
backend/.phpunit.result.cache
backend/database/*.sqlite
backend/database/*.sqlite-journal

# ==========================================
# Frontend (Node / React / Vite)
# ==========================================
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.oxlint-cache
frontend/.eslintcache
frontend/*.local
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*

# ==========================================
# Arquivos de IDEs e Editores
# ==========================================
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
